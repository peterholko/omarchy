{
  "manifest_version": 3,
  "name": "Omarchy LLM prompt log",
  "version": "1.0.0",
  "description": "Records prompts submitted to known LLM chat sites for a parent on a child install. Installed by the administrator. Does not block access.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://chat.deepseek.com/*",
    "https://poe.com/*",
    "https://*.poe.com/*",
    "https://you.com/*",
    "https://huggingface.co/*",
    "https://character.ai/*",
    "https://*.character.ai/*",
    "https://chat.mistral.ai/*",
    "https://mistral.ai/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://phind.com/*",
    "https://*.phind.com/*"
  ],
  "background": {
    "service_worker": "background-1.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://poe.com/*",
        "https://*.poe.com/*",
        "https://you.com/*",
        "https://huggingface.co/*",
        "https://character.ai/*",
        "https://*.character.ai/*",
        "https://chat.mistral.ai/*",
        "https://mistral.ai/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://phind.com/*",
        "https://*.phind.com/*"
      ],
      "js": ["content-isolated.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://poe.com/*",
        "https://*.poe.com/*",
        "https://you.com/*",
        "https://huggingface.co/*",
        "https://character.ai/*",
        "https://*.character.ai/*",
        "https://chat.mistral.ai/*",
        "https://mistral.ai/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://phind.com/*",
        "https://*.phind.com/*"
      ],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
