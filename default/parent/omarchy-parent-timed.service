# Omarchy kids mode: the screen-time daemon, counting the kid's time from
# logind, warning her, locking at zero, and crediting the arithmetic. Installed
# to /etc/systemd/system by `omarchy-parent time on`. Root, because the point
# is that the account being limited cannot stop it; it still reaches the
# desktop through /run/user/<uid>, so the sandboxing stays modest on purpose.
[Unit]
Description=Omarchy screen-time daemon
Documentation=file:///usr/share/omarchy/lib/screen-time/README.md
After=systemd-logind.service
Wants=systemd-logind.service

[Service]
Type=simple
Environment=OMARCHY_PATH=/usr/share/omarchy
ExecStart=/usr/bin/omarchy-parent-timed
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
RuntimeDirectory=omarchy-parent/screen-time
RuntimeDirectoryMode=0755
StateDirectory=omarchy/parent/screen-time
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
