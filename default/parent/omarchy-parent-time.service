# One tick of a child install's screen-time countdown (plans/kids-screen-time.md).
# Installed to /etc/systemd/system and enabled by `omarchy-parent time on`,
# which is why this ships under default/ rather than as a packaged unit.
[Unit]
Description=Omarchy screen-time countdown tick
ConditionPathExistsGlob=/var/lib/omarchy/parent/*/time/enabled

[Service]
Type=oneshot
ExecStart=/usr/bin/omarchy-parent-time-tick
