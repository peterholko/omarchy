#!/bin/bash

# omarchy:summary=One minute of a child install's screen-time countdown
# omarchy:hidden=true

# Run by omarchy-parent-time.timer (default/parent/) as root, once a minute.
# For every child account with screen time on: charge a minute when one of the
# account's graphical sessions is active and unlocked, and once the budget is
# spent, lock every graphical session and end any console or ssh login. The
# budget itself is owned by omarchy-parent-quiz; this only asks it to consume.
#
# logind's LockedHint is not raised by the shell's session lock, so the lock
# state is asked of the shell itself, over its IPC, as the kid. A session whose
# shell cannot answer counts as unlocked: with the shell gone there is no lock
# screen, and a bare compositor is still screen time. Locking it is likewise
# impossible, so that session is ended instead.

set -euo pipefail

STATE_ROOT="${OMARCHY_PARENT_STATE_DIR:-/var/lib/omarchy/parent}"
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
TICK_SECONDS=60

(( EUID == 0 )) || [[ -n ${OMARCHY_PARENT_STATE_DIR:-} ]] || {
  echo "Error: omarchy-parent-time-tick must run as root" >&2
  exit 1
}

log_event() {
  local dir=$1
  shift
  [[ -f $dir/log ]] || { : >"$dir/log"; chmod 0600 "$dir/log"; }
  printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$dir/log"
}

session_property() {
  loginctl show-session "$1" -p "$2" 2>/dev/null | sed -n "s/^$2=//p"
}

# One line per session of the user: "<id> <type> <active>".
sessions_of() {
  local user=$1 id
  for id in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{ print $1 }'); do
    [[ $(session_property "$id" Name) == "$user" ]] || continue
    [[ $(session_property "$id" Class) == "user" ]] || continue
    printf '%s %s %s\n' "$id" "$(session_property "$id" Type)" "$(session_property "$id" Active)"
  done
}

graphical() {
  case $1 in
    wayland|x11|mir) return 0 ;;
  esac
  return 1
}

# Runs a command inside the kid's session environment, where the shell's IPC
# socket lives.
as_user() {
  local user=$1 uid
  shift
  uid=$(id -u "$user")
  runuser -u "$user" -- env "XDG_RUNTIME_DIR=/run/user/$uid" "OMARCHY_PATH=$OMARCHY_PATH" "$@"
}

# "true", "false", or "unknown" when the shell does not answer.
lock_state() {
  local answer
  answer=$(as_user "$1" omarchy-shell lock isLocked 2>/dev/null) || answer=unknown
  case $answer in
    true|false) echo "$answer" ;;
    *) echo unknown ;;
  esac
}

lock_session() {
  local user=$1 id=$2
  as_user "$user" omarchy-shell -q lock lock 2>/dev/null || true
  if [[ $(lock_state "$user") == "true" ]]; then
    return 0
  fi
  # No shell to show a lock screen: there is nothing to keep her in but the
  # session itself.
  loginctl terminate-session "$id" 2>/dev/null || true
  return 1
}

tick_account() {
  local user=$1 dir=$2 budget id type active unlocked=false

  # consume 0 rolls the day over (free minutes) and refreshes status.json even
  # while nobody is logged in.
  budget=$(omarchy-parent-quiz --user "$user" consume 0)

  # School hours: no charge, no lock; the next tick after the window ends
  # picks the countdown back up.
  if omarchy-parent-quiz --user "$user" school; then
    return 0
  fi

  local -a graphical_sessions=() console_sessions=()
  while read -r id type active; do
    [[ -n $id ]] || continue
    if graphical "$type"; then
      graphical_sessions+=("$id")
      if [[ $active == "yes" && $(lock_state "$user") != "true" ]]; then
        unlocked=true
      fi
    else
      console_sessions+=("$id")
    fi
  done < <(sessions_of "$user")

  if $unlocked && (( budget > 0 )); then
    budget=$(omarchy-parent-quiz --user "$user" consume "$TICK_SECONDS")
  fi

  (( budget > 0 )) && return 0

  # ${arr[@]+"${arr[@]}"}: an empty array expands to nothing under set -u on
  # every bash, where a bare "${arr[@]}" is an unbound variable before 4.4.
  for id in ${graphical_sessions[@]+"${graphical_sessions[@]}"}; do
    if [[ $(lock_state "$user") == "true" ]]; then
      continue
    fi
    if lock_session "$user" "$id"; then
      log_event "$dir" "locked session $id: budget spent"
    else
      log_event "$dir" "ended session $id: budget spent and no shell to lock it"
    fi
  done
  for id in ${console_sessions[@]+"${console_sessions[@]}"}; do
    loginctl terminate-session "$id" 2>/dev/null || true
    log_event "$dir" "ended console session $id: budget spent"
  done
}

shopt -s nullglob
for marker in "$STATE_ROOT"/*/time/enabled; do
  dir=${marker%/enabled}
  user=${dir#"$STATE_ROOT"/}
  user=${user%/time}
  tick_account "$user" "$dir"
done
