#!/usr/bin/python3
# omarchy:summary=Native messaging host: forward an LLM prompt to the parent collector
# omarchy:hidden=true

"""Chromium native messaging host for the parent LLM prompt log.

Runs as the kid. Reads one length-prefixed JSON message from stdin, writes it
to the root collector's unix socket, and replies to Chromium. Never opens the
journal.
"""

from __future__ import annotations

import json
import os
import socket
import struct
import sys


SOCKET_PATH = os.environ.get("OMARCHY_PARENT_LLM_SOCKET", "/run/omarchy-parent-llm.sock")
MAX_PROMPT = 32 * 1024


def read_message() -> dict | None:
  header = sys.stdin.buffer.read(4)
  if len(header) < 4:
    return None
  (length,) = struct.unpack("<I", header)
  if length <= 0 or length > 256 * 1024:
    return None
  payload = sys.stdin.buffer.read(length)
  if len(payload) < length:
    return None
  try:
    data = json.loads(payload.decode("utf-8"))
  except (json.JSONDecodeError, UnicodeDecodeError):
    return None
  return data if isinstance(data, dict) else None


def write_message(data: dict) -> None:
  encoded = json.dumps(data, separators=(",", ":")).encode("utf-8")
  sys.stdout.buffer.write(struct.pack("<I", len(encoded)))
  sys.stdout.buffer.write(encoded)
  sys.stdout.buffer.flush()


def sanitize(data: dict) -> dict | None:
  prompt = str(data.get("prompt") or "").strip()
  if not prompt:
    return None
  if len(prompt) > MAX_PROMPT:
    prompt = prompt[:MAX_PROMPT]
  host = str(data.get("host") or "")
  url = str(data.get("url") or "")
  try:
    attachments = int(data.get("attachments") or 0)
  except (TypeError, ValueError):
    attachments = 0
  return {
    "source": "browser",
    "host": host,
    "url": url,
    "prompt": prompt,
    "attachments": attachments,
  }


def forward(payload: dict) -> bool:
  try:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(1.5)
    sock.connect(SOCKET_PATH)
    sock.sendall((json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8"))
    sock.close()
    return True
  except OSError:
    return False


def main() -> None:
  message = read_message()
  if message is None:
    write_message({"ok": False})
    return
  payload = sanitize(message)
  if payload is None:
    write_message({"ok": False})
    return
  write_message({"ok": forward(payload)})


if __name__ == "__main__":
  main()
