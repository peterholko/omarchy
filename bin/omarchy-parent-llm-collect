#!/usr/bin/python3
# omarchy:summary=Collect LLM prompts into the parent journal and daily report
# omarchy:hidden=true

"""Root-side LLM prompt log for a child install.

serve    read one JSON object from stdin (systemd socket activation) and append
append   write a JSON object from stdin without SO_PEERCRED (tests, harvest)
harvest  copy new user turns out of the kid's CLI transcripts and History
report   write /root/llm-reports/YYYY-MM-DD.md from the journal
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import socket
import sqlite3
import struct
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any
from urllib.parse import urlparse


MAX_PROMPT = 32 * 1024
MAX_EVENTS_PER_DAY = 5000
SO_PEERCRED = 17


def fail(message: str) -> None:
  print(f"Error: {message}", file=sys.stderr)
  raise SystemExit(1)


def now_local() -> datetime:
  return datetime.now().astimezone()


def parse_ts(value: Any) -> datetime | None:
  if value is None or value == "":
    return None
  if isinstance(value, (int, float)):
    stamp = float(value)
    if stamp > 10_000_000_000:
      stamp = stamp / 1000
    try:
      return datetime.fromtimestamp(stamp).astimezone()
    except (OverflowError, OSError, ValueError):
      return None
  text = str(value).strip()
  if text.endswith("Z"):
    text = text[:-1] + "+00:00"
  try:
    parsed = datetime.fromisoformat(text)
  except ValueError:
    return None
  if parsed.tzinfo is None:
    parsed = parsed.replace(tzinfo=timezone.utc)
  return parsed.astimezone()


def local_date(value: Any = None) -> str:
  parsed = parse_ts(value) if value is not None else now_local()
  if parsed is None:
    parsed = now_local()
  return parsed.strftime("%Y-%m-%d")


def local_time(value: Any) -> str:
  parsed = parse_ts(value)
  if parsed is None:
    return "??:??"
  return parsed.strftime("%H:%M")


def env_path(name: str, default: str = "") -> Path:
  value = os.environ.get(name, default)
  return Path(value) if value else Path(default)


def journal_path(args: argparse.Namespace | None = None) -> Path:
  if args is not None and getattr(args, "journal", None):
    return Path(args.journal)
  path = os.environ.get("OMARCHY_PARENT_LLM_JOURNAL", "")
  if not path:
    fail("OMARCHY_PARENT_LLM_JOURNAL is not set")
  return Path(path)


def report_dir(args: argparse.Namespace | None = None) -> Path:
  if args is not None and getattr(args, "out_dir", None):
    return Path(args.out_dir)
  path = os.environ.get("OMARCHY_PARENT_LLM_REPORT_DIR", "/root/llm-reports")
  return Path(path)


def state_dir(args: argparse.Namespace | None = None) -> Path:
  path = os.environ.get("OMARCHY_PARENT_LLM_STATE", "")
  if path:
    return Path(path)
  if args is not None and getattr(args, "journal", None):
    return Path(args.journal).parent
  journal = os.environ.get("OMARCHY_PARENT_LLM_JOURNAL", "")
  return Path(journal).parent if journal else Path(".")


def kid_user() -> str:
  return os.environ.get("OMARCHY_PARENT_LLM_USER", "")


def kid_uid() -> int | None:
  raw = os.environ.get("OMARCHY_PARENT_LLM_UID", "")
  if not raw:
    return None
  try:
    return int(raw)
  except ValueError:
    return None


def kid_home() -> Path:
  path = os.environ.get("OMARCHY_PARENT_LLM_HOME", "")
  if path:
    return Path(path)
  return Path.home()


def hosts_file(args: argparse.Namespace | None = None) -> Path:
  path = os.environ.get("OMARCHY_PARENT_LLM_HOSTS", "")
  if path:
    return Path(path)
  return state_dir(args) / "hosts.txt"


def load_hosts(path: Path | None = None, args: argparse.Namespace | None = None) -> set[str]:
  target = path or hosts_file(args)
  hosts: set[str] = set()
  if not target.is_file():
    return hosts
  for line in target.read_text(encoding="utf-8", errors="replace").splitlines():
    line = line.strip()
    if not line or line.startswith("#"):
      continue
    hosts.add(line.lower().removeprefix("www."))
  return hosts


def normalize_prompt(prompt: str) -> str:
  return prompt.strip()


def normalize_host(host: str) -> str:
  host = host.strip().lower()
  if host.startswith("www."):
    host = host[4:]
  return host


def strip_query(url: str) -> str:
  if not url:
    return ""
  parsed = urlparse(url)
  if not parsed.scheme:
    return url.split("?", 1)[0]
  return parsed._replace(query="", fragment="").geturl()


def event_hash(day: str, host: str, prompt: str) -> str:
  payload = f"{day}\n{host}\n{normalize_prompt(prompt)}".encode()
  return hashlib.sha256(payload).hexdigest()[:32]


def text_of(value: Any) -> str:
  if value is None:
    return ""
  if isinstance(value, str):
    return value
  if isinstance(value, (int, float, bool)):
    return ""
  if isinstance(value, list):
    parts = [text_of(item) for item in value]
    return "\n".join(part for part in parts if part)
  if not isinstance(value, dict):
    return ""
  kind = str(value.get("type") or "")
  if kind in ("tool_result", "tool_use", "tool_call"):
    return ""
  if isinstance(value.get("text"), str):
    return value["text"]
  if value.get("content") is not None:
    return text_of(value["content"])
  if value.get("parts") is not None:
    return text_of(value["parts"])
  return ""


def role_of(message: Any) -> str:
  if not isinstance(message, dict):
    return ""
  author = message.get("author")
  role = message.get("role") or (author.get("role") if isinstance(author, dict) else None) or message.get("type") or ""
  return str(role).lower()


def user_text_from_record(obj: Any) -> str:
  if not isinstance(obj, dict):
    return ""
  message = obj.get("message") if isinstance(obj.get("message"), dict) else obj
  role = role_of(message)
  record_type = str(obj.get("type") or "").lower()
  if role not in ("user", "human") and record_type not in ("user", "human"):
    return ""
  text = text_of(message.get("content") if isinstance(message, dict) else "")
  if not text:
    text = text_of(obj.get("content") or obj.get("text") or obj.get("prompt"))
  return normalize_prompt(text)


def peer_uid(fd: int = 0) -> int | None:
  try:
    sock = socket.fromfd(fd, socket.AF_UNIX, socket.SOCK_STREAM)
  except OSError:
    return None
  try:
    creds = sock.getsockopt(socket.SOL_SOCKET, SO_PEERCRED, struct.calcsize("3i"))
    _pid, uid, _gid = struct.unpack("3i", creds)
    return int(uid)
  except OSError:
    return None
  finally:
    sock.close()


def read_json_stdin() -> dict[str, Any]:
  raw = sys.stdin.buffer.read()
  if not raw:
    fail("no payload")
  text = raw.decode("utf-8", errors="replace").strip()
  if not text:
    fail("no payload")
  try:
    data = json.loads(text.split("\n", 1)[0] if text.startswith("{") else text)
  except json.JSONDecodeError as exc:
    fail(f"payload is not JSON: {exc}")
  if not isinstance(data, dict):
    fail("payload must be a JSON object")
  return data


def count_today(path: Path, day: str) -> int:
  if not path.is_file():
    return 0
  count = 0
  with path.open("r", encoding="utf-8", errors="replace") as handle:
    for line in handle:
      line = line.strip()
      if not line:
        continue
      try:
        event = json.loads(line)
      except json.JSONDecodeError:
        continue
      if local_date(event.get("ts")) == day:
        count += 1
  return count


def recent_hashes(path: Path, limit: int = 80) -> set[str]:
  hashes: set[str] = set()
  if not path.is_file():
    return hashes
  lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
  for line in lines[-limit:]:
    line = line.strip()
    if not line:
      continue
    try:
      event = json.loads(line)
    except json.JSONDecodeError:
      continue
    digest = event.get("hash")
    if digest:
      hashes.add(str(digest))
  return hashes


def sanitize_event(data: dict[str, Any], user: str) -> dict[str, Any] | None:
  prompt = normalize_prompt(str(data.get("prompt") or ""))
  if not prompt:
    return None
  if len(prompt) > MAX_PROMPT:
    prompt = prompt[:MAX_PROMPT]
  source = str(data.get("source") or "browser")
  if source not in ("browser", "cli"):
    source = "browser"
  host = normalize_host(str(data.get("host") or data.get("tool") or ""))
  ts = data.get("ts") or now_local().isoformat(timespec="seconds")
  day = local_date(ts)
  event: dict[str, Any] = {
    "ts": ts if isinstance(ts, str) else now_local().isoformat(timespec="seconds"),
    "user": user,
    "source": source,
    "prompt": prompt,
    "hash": event_hash(day, host, prompt),
  }
  if source == "cli":
    event["tool"] = host or "agent"
  else:
    event["host"] = host
    event["url"] = strip_query(str(data.get("url") or ""))
  attachments = data.get("attachments")
  try:
    count = int(attachments)
  except (TypeError, ValueError):
    count = 0
  if count > 0:
    event["attachments"] = count
  return event


def append_event(path: Path, event: dict[str, Any]) -> bool:
  path.parent.mkdir(parents=True, exist_ok=True)
  day = local_date(event.get("ts"))
  if event.get("hash") in recent_hashes(path):
    return False
  if count_today(path, day) >= MAX_EVENTS_PER_DAY:
    return False
  line = json.dumps(event, ensure_ascii=False, separators=(",", ":"))
  flags = os.O_APPEND | os.O_CREAT | os.O_WRONLY
  fd = os.open(path, flags, 0o600)
  with os.fdopen(fd, "a", encoding="utf-8") as handle:
    handle.write(line + "\n")
    handle.flush()
    os.fsync(handle.fileno())
  try:
    os.chmod(path, 0o600)
  except OSError:
    pass
  return True


def cmd_append(args: argparse.Namespace) -> None:
  user = args.user or kid_user()
  data = read_json_stdin()
  event = sanitize_event(data, user)
  if event is None:
    return
  append_event(journal_path(args), event)


def cmd_serve(args: argparse.Namespace) -> None:
  allowed = args.uid if args.uid is not None else kid_uid()
  if allowed is None:
    fail("OMARCHY_PARENT_LLM_UID is not set")
  peer = peer_uid(0)
  if peer is None or peer != allowed:
    fail("refusing payload from uid that is not the kid account")
  cmd_append(args)


def harvest_jsonl(root: Path, since: datetime, user: str, tool: str) -> list[dict[str, Any]]:
  events: list[dict[str, Any]] = []
  if not root.is_dir():
    return events
  for path in root.rglob("*.jsonl"):
    try:
      if path.stat().st_mtime < since.timestamp() - 60:
        continue
    except OSError:
      continue
    try:
      with path.open("r", encoding="utf-8", errors="replace") as handle:
        for line in handle:
          line = line.strip()
          if not line:
            continue
          try:
            record = json.loads(line)
          except json.JSONDecodeError:
            continue
          text = user_text_from_record(record)
          if not text:
            continue
          stamp = record.get("timestamp") or record.get("ts") or (record.get("message") or {}).get("timestamp")
          parsed = parse_ts(stamp)
          if parsed is not None and parsed < since:
            continue
          events.append({
            "source": "cli",
            "tool": tool,
            "prompt": text,
            "ts": (parsed or now_local()).isoformat(timespec="seconds"),
            "user": user,
          })
    except OSError as exc:
      print(f"Ignoring unreadable {path}: {exc}", file=sys.stderr)
  return events


def chrome_to_datetime(value: int) -> datetime | None:
  try:
    unix = (int(value) / 1_000_000) - 11_644_473_600
    return datetime.fromtimestamp(unix).astimezone()
  except (OverflowError, OSError, ValueError):
    return None


def harvest_history(home: Path, hosts: set[str], day: str) -> dict[str, int]:
  history = home / ".config" / "chromium" / "Default" / "History"
  if not history.is_file():
    return {}
  counts: dict[str, int] = {}
  tmp = None
  try:
    with tempfile.NamedTemporaryFile(prefix="omarchy-llm-history-", delete=False) as handle:
      tmp = Path(handle.name)
      handle.write(history.read_bytes())
    conn = sqlite3.connect(f"file:{tmp}?mode=ro", uri=True)
    try:
      try:
        rows = conn.execute(
          "SELECT urls.url, visits.visit_time FROM visits JOIN urls ON visits.url = urls.id"
        )
      except sqlite3.Error:
        rows = conn.execute("SELECT url, last_visit_time FROM urls")
      for url, visit_time in rows:
        host = normalize_host(urlparse(str(url)).hostname or "")
        if host not in hosts:
          continue
        visited = chrome_to_datetime(visit_time)
        if visited is None or visited.strftime("%Y-%m-%d") != day:
          continue
        counts[host] = counts.get(host, 0) + 1
    finally:
      conn.close()
  except sqlite3.Error as exc:
    print(f"Ignoring Chromium History: {exc}", file=sys.stderr)
  except OSError as exc:
    print(f"Ignoring Chromium History: {exc}", file=sys.stderr)
  finally:
    if tmp is not None:
      tmp.unlink(missing_ok=True)
  return counts


def cursor_path(args: argparse.Namespace | None = None) -> Path:
  return state_dir(args) / "harvest-cursor"


def read_cursor(args: argparse.Namespace | None = None) -> datetime:
  path = cursor_path(args)
  if path.is_file():
    parsed = parse_ts(path.read_text(encoding="utf-8").strip())
    if parsed is not None:
      return parsed
  return now_local() - timedelta(days=1)


def write_cursor(value: datetime, args: argparse.Namespace | None = None) -> None:
  path = cursor_path(args)
  path.parent.mkdir(parents=True, exist_ok=True)
  path.write_text(value.isoformat(timespec="seconds") + "\n", encoding="utf-8")
  os.chmod(path, 0o600)


def cmd_harvest(args: argparse.Namespace) -> None:
  user = args.user or kid_user()
  home = Path(args.home) if args.home else kid_home()
  since = read_cursor(args)
  journal = journal_path(args)
  events: list[dict[str, Any]] = []
  events.extend(harvest_jsonl(home / ".claude" / "projects", since, user, "claude"))
  events.extend(harvest_jsonl(home / ".codex" / "sessions", since, user, "codex"))
  events.extend(harvest_jsonl(home / ".codex" / "archived_sessions", since, user, "codex"))
  grok_home = Path(os.environ.get("GROK_HOME", home / ".grok"))
  events.extend(harvest_jsonl(grok_home, since, user, "grok"))
  for event in events:
    sanitized = sanitize_event(event, user)
    if sanitized is not None:
      append_event(journal, sanitized)

  hosts = load_hosts(args=args)
  day = local_date()
  visits = harvest_history(home, hosts, day)
  visits_path = state_dir(args) / f"visits-{day}.json"
  visits_path.parent.mkdir(parents=True, exist_ok=True)
  visits_path.write_text(json.dumps(visits, indent=2) + "\n", encoding="utf-8")
  os.chmod(visits_path, 0o600)
  write_cursor(now_local(), args)


def load_journal(path: Path, day: str) -> list[dict[str, Any]]:
  events: list[dict[str, Any]] = []
  if not path.is_file():
    return events
  with path.open("r", encoding="utf-8", errors="replace") as handle:
    for line in handle:
      line = line.strip()
      if not line:
        continue
      try:
        event = json.loads(line)
      except json.JSONDecodeError:
        continue
      if local_date(event.get("ts")) == day:
        events.append(event)
  return events


def one_line(text: str) -> str:
  return " ".join(text.split())


def write_atomic(path: Path, content: str, mode: int = 0o600) -> None:
  path.parent.mkdir(parents=True, exist_ok=True)
  fd, tmp_name = tempfile.mkstemp(prefix=".llm-report-", dir=str(path.parent))
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      handle.write(content)
      handle.flush()
      os.fsync(handle.fileno())
    os.chmod(tmp_name, mode)
    os.replace(tmp_name, path)
  except Exception:
    try:
      os.unlink(tmp_name)
    except OSError:
      pass
    raise


def render_report(user: str, day: str, events: list[dict[str, Any]], visits: dict[str, int]) -> str:
  browser = [event for event in events if event.get("source") != "cli"]
  cli = [event for event in events if event.get("source") == "cli"]
  hosts: dict[str, list[dict[str, Any]]] = {}
  for event in browser:
    hosts.setdefault(event.get("host") or "unknown", []).append(event)
  tools: dict[str, list[dict[str, Any]]] = {}
  for event in cli:
    tools.setdefault(event.get("tool") or "agent", []).append(event)

  lines = [f"# LLM prompt report — {user or 'kid'} — {day}", ""]
  summary = f"{len(events)} prompt{'s' if len(events) != 1 else ''}"
  if hosts:
    summary += f" on {len(hosts)} chat site{'s' if len(hosts) != 1 else ''}"
  if cli:
    summary += f". {len(cli)} CLI turn{'s' if len(cli) != 1 else ''}"
  else:
    summary += ". 0 CLI sessions"
  lines.append(summary + ".")
  if visits:
    visit_bits = [f"{host} {count} times" for host, count in sorted(visits.items())]
    lines.append("Visited " + ", ".join(visit_bits) + " (from Chromium history).")
  elif not events:
    lines.append("No prompts captured and no LLM-site visits recorded.")
  lines.append("")

  for host in sorted(hosts):
    group = hosts[host]
    lines.append(f"## {host} ({len(group)})")
    lines.append("")
    for event in group:
      extra = ""
      if event.get("attachments"):
        extra = f" [{event['attachments']} attachment{'s' if event['attachments'] != 1 else ''}]"
      lines.append(f"- {local_time(event.get('ts'))}  {one_line(event.get('prompt', ''))}{extra}")
    lines.append("")

  if tools:
    lines.append("## CLI agents")
    lines.append("")
    for tool in sorted(tools):
      group = tools[tool]
      lines.append(f"### {tool} ({len(group)})")
      lines.append("")
      for event in group:
        lines.append(f"- {local_time(event.get('ts'))}  {one_line(event.get('prompt', ''))}")
      lines.append("")

  return "\n".join(lines).rstrip() + "\n"


def cmd_report(args: argparse.Namespace) -> None:
  user = args.user or kid_user()
  day = args.date or local_date()
  events = load_journal(journal_path(args), day)
  visits_path = state_dir(args) / f"visits-{day}.json"
  visits: dict[str, int] = {}
  if visits_path.is_file():
    try:
      loaded = json.loads(visits_path.read_text(encoding="utf-8"))
      if isinstance(loaded, dict):
        visits = {str(k): int(v) for k, v in loaded.items()}
    except (json.JSONDecodeError, ValueError, TypeError):
      visits = {}
  body = render_report(user, day, events, visits)
  out_dir = report_dir(args)
  path = out_dir / f"{day}.md"
  write_atomic(path, body)
  latest = out_dir / "latest.md"
  try:
    if latest.is_symlink() or latest.exists():
      latest.unlink()
    latest.symlink_to(path.name)
  except OSError:
    write_atomic(latest, body)
  if args.print:
    sys.stdout.write(body)


def build_parser() -> argparse.ArgumentParser:
  parser = argparse.ArgumentParser(prog="omarchy-parent-llm-collect")
  parser.add_argument("--journal", default=None)
  parser.add_argument("--user", default=None)
  parser.add_argument("--uid", type=int, default=None)
  parser.add_argument("--home", default=None)
  parser.add_argument("--out-dir", default=None)
  parser.add_argument("--date", default=None)
  parser.add_argument("--print", action="store_true")
  parser.add_argument("command", nargs="?", default="serve", choices=("serve", "append", "harvest", "report"))
  return parser


def main() -> None:
  parser = build_parser()
  args = parser.parse_args()
  if args.command == "serve":
    cmd_serve(args)
  elif args.command == "append":
    cmd_append(args)
  elif args.command == "harvest":
    cmd_harvest(args)
  elif args.command == "report":
    cmd_report(args)
  else:
    fail(f"unknown command {args.command}")


if __name__ == "__main__":
  main()
