#!/bin/bash

# omarchy:summary=Ask and check the arithmetic that earns a child screen time
# omarchy:args=[--user NAME] <question|answer|status|gate|school|consume SECONDS|credit MINUTES>
# omarchy:hidden=true

# The kid-facing half of screen time (plans/kids-screen-time.md). Root owns
# the budget under /var/lib/omarchy/parent/<kid>/time/; the kid's lock screen
# reaches `question`, `answer`, and `status` through a passwordless sudo grant
# whose entries name each argument list exactly, and PAM runs `gate` as the
# kid to refuse an unlock while the budget is empty. The only free-form input,
# an answer, travels over stdin so the grant never needs a wildcard.
#
# The account is whoever sudo or PAM says it is: PAM_USER under pam_exec,
# SUDO_USER under the grant. The root-only subcommands the timer and the
# parent's `omarchy-parent time` use, `consume` and `credit`, name the account
# with --user; the grant lists none of those forms, so the kid cannot reach
# them.
#
# OMARCHY_PARENT_STATE_DIR redirects the state root for tests. It cannot reach
# the privileged paths: sudo resets the environment, pam_exec runs the gate
# with the PAM environment alone, and the timer runs under systemd.

set -euo pipefail

STATE_ROOT="${OMARCHY_PARENT_STATE_DIR:-/var/lib/omarchy/parent}"

DEFAULT_QUESTIONS=5   # questions in one set
DEFAULT_MINUTES=30    # minutes a whole set earns: each right answer is minutes/questions
DEFAULT_RATE=6        # legacy: minutes per right answer, read when a config has no minutes=
DEFAULT_CAP=120       # minutes that can be earned per day
DEFAULT_FREE=0        # minutes granted at the start of each day
DEFAULT_LEVEL=grade5
QUESTION_TTL=1800     # seconds a question stays answerable: paper and pencil take time
MAX_ATTEMPTS=2      # wrong answers before the answer is shown and the question retired

fail() {
  echo "Error: $1" >&2
  exit 1
}

# --- generator ---
# Self-contained so the test suite can source these functions on their own.
# Integer answers only: the kid's field is a plain number. Operands avoid 0,
# 1, and powers of ten, which make for dull questions.

rand_between() {
  local lo=$1 hi=$2
  echo $(( lo + (RANDOM * 32768 + RANDOM) % (hi - lo + 1) ))
}

dull_operand() {
  case $1 in
    0|1|10|100|1000|10000|100000) return 0 ;;
  esac
  return 1
}

pick_operand() {
  local n
  while :; do
    n=$(rand_between "$1" "$2")
    dull_operand "$n" || break
  done
  echo "$n"
}

# Sets question_text and question_answer for the level.
generate_question() {
  local level=$1 roll a b c kind
  roll=$(rand_between 1 100)

  case $level in
    grade1)
      # Adding and taking away within 20.
      if (( roll <= 55 )); then kind=add20
      else kind=sub20
      fi
      ;;
    grade2)
      # Within 100, with a carry more often than not; the first tables.
      if (( roll <= 40 )); then kind=add100
      elif (( roll <= 75 )); then kind=sub100
      else kind=mulsmall
      fi
      ;;
    grade3)
      # Times tables to 9 × 9 and their divisions; sums to 1000.
      if (( roll <= 25 )); then kind=add1000
      elif (( roll <= 45 )); then kind=sub1000
      elif (( roll <= 75 )); then kind=table
      else kind=tablediv
      fi
      ;;
    grade4)
      # Sums to 10000, hundreds times ones, long division by one digit.
      if (( roll <= 25 )); then kind=add10000
      elif (( roll <= 45 )); then kind=sub10000
      elif (( roll <= 75 )); then kind=mul3x1
      else kind=div1
      fi
      ;;
    grade6)
      if (( roll <= 15 )); then kind=add
      elif (( roll <= 30 )); then kind=sub
      elif (( roll <= 40 )); then kind=mul2x2
      elif (( roll <= 50 )); then kind=mul3x1
      elif (( roll <= 65 )); then kind=mul3x2
      elif (( roll <= 75 )); then kind=div1
      elif (( roll <= 90 )); then kind=div2
      else kind=ops
      fi
      ;;
    *)
      if (( roll <= 25 )); then kind=add
      elif (( roll <= 50 )); then kind=sub
      elif (( roll <= 65 )); then kind=mul2x2
      elif (( roll <= 80 )); then kind=mul3x1
      else kind=div1
      fi
      ;;
  esac

  case $kind in
    add20)
      a=$(pick_operand 2 18); b=$(pick_operand 2 $((20 - a)))
      question_text="What is $a + $b?"; question_answer=$((a + b))
      ;;
    sub20)
      a=$(pick_operand 4 20); b=$(pick_operand 2 $((a - 2)))
      question_text="What is $a - $b?"; question_answer=$((a - b))
      ;;
    add100)
      a=$(pick_operand 11 88); b=$(pick_operand 11 $((99 - a)))
      question_text="What is $a + $b?"; question_answer=$((a + b))
      ;;
    sub100)
      a=$(pick_operand 25 99); b=$(pick_operand 11 $((a - 2)))
      question_text="What is $a - $b?"; question_answer=$((a - b))
      ;;
    mulsmall)
      a=$(pick_operand 2 5); b=$(pick_operand 2 9)
      question_text="What is $a × $b?"; question_answer=$((a * b))
      ;;
    add1000)
      a=$(pick_operand 101 898); b=$(pick_operand 101 $((999 - a)))
      question_text="What is $a + $b?"; question_answer=$((a + b))
      ;;
    sub1000)
      a=$(pick_operand 201 999); b=$(pick_operand 101 $((a - 2)))
      question_text="What is $a - $b?"; question_answer=$((a - b))
      ;;
    table)
      a=$(pick_operand 2 9); b=$(pick_operand 2 9)
      question_text="What is $a × $b?"; question_answer=$((a * b))
      ;;
    tablediv)
      while :; do
        b=$(pick_operand 2 9); c=$(pick_operand 2 9); a=$((b * c))
        dull_operand "$a" || break
      done
      question_text="What is $a ÷ $b?"; question_answer=$c
      ;;
    add10000)
      a=$(pick_operand 1001 8998); b=$(pick_operand 1001 $((9999 - a)))
      question_text="What is $a + $b?"; question_answer=$((a + b))
      ;;
    sub10000)
      a=$(pick_operand 2001 9999); b=$(pick_operand 1001 $((a - 2)))
      question_text="What is $a - $b?"; question_answer=$((a - b))
      ;;
    add)
      a=$(pick_operand 100 99999); b=$(pick_operand 100 99999)
      question_text="What is $a + $b?"; question_answer=$((a + b))
      ;;
    sub)
      a=$(pick_operand 100 99999)
      b=$(pick_operand 100 99999)
      while (( a == b )); do b=$(pick_operand 100 99999); done
      if (( a < b )); then c=$a; a=$b; b=$c; fi
      question_text="What is $a - $b?"; question_answer=$((a - b))
      ;;
    mul2x2)
      a=$(pick_operand 12 99); b=$(pick_operand 12 99)
      question_text="What is $a × $b?"; question_answer=$((a * b))
      ;;
    mul3x1)
      a=$(pick_operand 101 999); b=$(pick_operand 2 9)
      question_text="What is $a × $b?"; question_answer=$((a * b))
      ;;
    mul3x2)
      a=$(pick_operand 101 999); b=$(pick_operand 12 99)
      question_text="What is $a × $b?"; question_answer=$((a * b))
      ;;
    div1)
      # Built by multiplying, so it always divides exactly; a product that
      # lands on a dull number is rolled again.
      while :; do
        b=$(pick_operand 2 9); c=$(pick_operand 12 999); a=$((b * c))
        dull_operand "$a" || break
      done
      question_text="What is $a ÷ $b?"; question_answer=$c
      ;;
    div2)
      while :; do
        b=$(pick_operand 12 99); c=$(pick_operand 12 99); a=$((b * c))
        dull_operand "$a" || break
      done
      question_text="What is $a ÷ $b?"; question_answer=$c
      ;;
    ops)
      b=$(pick_operand 2 12); c=$(pick_operand 2 12)
      if (( RANDOM % 2 )); then
        a=$(pick_operand 2 50)
        question_text="What is $a + $b × $c?"; question_answer=$((a + b * c))
      else
        # a stays below the product, so the answer is always positive.
        a=$(pick_operand 2 $((b * c - 1)))
        question_text="What is $b × $c - $a?"; question_answer=$((b * c - a))
      fi
      ;;
  esac
}
# --- end generator ---

account() {
  local user="${NAMED_USER:-${PAM_USER:-${SUDO_USER:-}}}"
  [[ -n $user ]] || user=$(id -un)
  [[ $user != "root" ]] || fail "no child account named: pass --user, or run through the sudo grant or under PAM"
  [[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "invalid account name: $user"
  printf '%s' "$user"
}

require_root() {
  (( EUID == 0 )) || [[ -n ${OMARCHY_PARENT_STATE_DIR:-} ]] ||
    fail "omarchy-parent-quiz $1 must run as root"
}

dir_for() {
  printf '%s/%s/time' "$STATE_ROOT" "$1"
}

read_file() {
  local path="$DIR/$1" fallback="${2:-}"
  if [[ -f $path ]]; then
    cat "$path"
  else
    printf '%s' "$fallback"
  fi
}

# Files the kid's shell and the PAM gate read stay world-readable; the pending
# question and the log, which carry answers, stay root's alone. Written whole
# and renamed into place, so a reader never sees a half-written value.
write_file() {
  local name=$1 value=$2 mode=${3:-0644} stage
  stage=$(mktemp "$DIR/.$name.XXXXXX")
  printf '%s\n' "$value" >"$stage"
  chmod "$mode" "$stage"
  mv -f "$stage" "$DIR/$name"
}

config() {
  local key=$1 fallback=$2 value=""
  [[ -f $DIR/config ]] && value=$(sed -n "s/^$key=//p" "$DIR/config" | tail -1)
  [[ $value =~ ^[A-Za-z0-9]+$ ]] || value=$fallback
  printf '%s' "$value"
}

log_event() {
  local stamp
  stamp=$(date '+%F %T')
  [[ -f $DIR/log ]] || { : >"$DIR/log"; chmod 0600 "$DIR/log"; }
  printf '%s %s\n' "$stamp" "$*" >>"$DIR/log"
}

# --- school schedule ---
# Windows the parent set with `omarchy-parent time school`, one per line and
# already normalized: the days as digits (1 is Monday, 7 Sunday) and the start
# and end as HHMM. Inside a window the countdown pauses and the gate stands
# aside, so the laptop is hers for schoolwork.

# The clock, or the test's idea of it: OMARCHY_PARENT_NOW ("<weekday> <HHMM>")
# is only honored alongside the state-root override, so a real gate or timer
# never reads a planted time.
now_parts() {
  if [[ -n ${OMARCHY_PARENT_STATE_DIR:-} && -n ${OMARCHY_PARENT_NOW:-} ]]; then
    printf '%s' "$OMARCHY_PARENT_NOW"
  else
    date '+%u %H%M'
  fi
}

in_school_hours() {
  [[ -f $DIR/schedule ]] || return 1
  local dow now days start end
  read -r dow now <<<"$(now_parts)"
  while read -r days start end; do
    [[ -n $days && -n $start && -n $end ]] || continue
    [[ $days == *"$dow"* ]] || continue
    if (( 10#$now >= 10#$start && 10#$now < 10#$end )); then
      return 0
    fi
  done <"$DIR/schedule"
  return 1
}

budget_seconds() {
  local budget
  budget=$(read_file budget 0)
  [[ $budget =~ ^-?[0-9]+$ ]] || budget=0
  (( budget < 0 )) && budget=0
  printf '%s' "$budget"
}

# The set: how many questions, and the minutes the whole set earns. A config
# from before the pair carries rate= (minutes per answer) and no minutes=.
set_questions() {
  local q
  q=$(config questions "$DEFAULT_QUESTIONS")
  [[ $q =~ ^[0-9]+$ ]] && (( q >= 1 )) || q=$DEFAULT_QUESTIONS
  printf '%s' "$q"
}

set_minutes() {
  local m rate
  m=$(config minutes "")
  if [[ ! $m =~ ^[0-9]+$ ]]; then
    rate=$(config rate "$DEFAULT_RATE")
    [[ $rate =~ ^[0-9]+$ ]] || rate=$DEFAULT_RATE
    m=$(( rate * $(set_questions) ))
  fi
  printf '%s' "$m"
}

# Seconds one right answer is worth: the set's minutes shared over its questions.
credit_seconds() {
  printf '%s' $(( $(set_minutes) * 60 / $(set_questions) ))
}

# Seconds as "30 min" or "7 min 30 s", for the report and the log's reader.
format_minutes() {
  local s=$1
  if (( s % 60 == 0 )); then printf '%s min' $(( s / 60 ))
  elif (( s < 60 )); then printf '%s s' "$s"
  else printf '%s min %s s' $(( s / 60 )) $(( s % 60 ))
  fi
}

write_status() {
  local enabled=false school=false
  [[ -f $DIR/enabled ]] && enabled=true
  in_school_hours && school=true
  local questions minutes earned rate
  questions=$(set_questions)
  minutes=$(set_minutes)
  earned=$(read_file earned 0)
  [[ $earned =~ ^[0-9]+$ ]] || earned=0
  # rate is minutes per right answer, for readers; it may be a fraction.
  rate=$(awk -v m="$minutes" -v q="$questions" 'BEGIN { printf "%g", m / q }')
  write_file status.json "$(printf '{"enabled":%s,"school":%s,"budget":%s,"earnedToday":%s,"usedToday":%s,"cap":%s,"rate":%s,"creditSeconds":%s,"questions":%s,"sessionMinutes":%s,"level":"%s"}' \
    "$enabled" "$school" "$(budget_seconds)" $(( (earned + 59) / 60 )) "$(read_file used 0)" "$(config cap "$DEFAULT_CAP")" \
    "$rate" "$(credit_seconds)" "$questions" "$minutes" "$(config level "$DEFAULT_LEVEL")")"
}

# A new day resets what was earned and hands out any free minutes.
roll_day() {
  local today previous
  today=$(date +%F)
  previous=$(read_file day)
  [[ $previous == "$today" ]] && return 0
  [[ -n $previous ]] && write_report "$previous" >/dev/null
  write_file day "$today"
  write_file earned 0
  write_file used 0
  local free
  free=$(config free "$DEFAULT_FREE")
  if (( free > 0 )); then
    write_file budget $(( $(budget_seconds) + free * 60 ))
    log_event "free $free"
  fi
}

# A day's report from the log and the counters, printed, and kept as
# reports/<date>.txt where only root reads it. Today's counters are live;
# a finished day's were captured when the day rolled over.
build_report() {
  local day=$1 used earned banked questions right wrong lines
  if [[ $day == "$(read_file day)" ]]; then
    used=$(read_file used 0)
    earned=$(read_file earned 0)
    banked=$(budget_seconds)
  else
    used=""
    earned=$(grep "^$day " "$DIR/log" 2>/dev/null | sed -n 's/.* correct [0-9]* +\([0-9]*\) .*/\1/p' | awk '{ s += $1 } END { print s + 0 }')
    banked=""
  fi
  lines=$(grep "^$day " "$DIR/log" 2>/dev/null || true)
  questions=$(grep -c ' question [0-9]* text=' <<<"$lines" || true)
  right=$(grep -c ' correct [0-9]* ' <<<"$lines" || true)
  wrong=$(grep -c ' wrong [0-9]* retired ' <<<"$lines" || true)
  echo "Screen time for $USER_NAME, $day"
  [[ $earned =~ ^[0-9]+$ ]] || earned=0
  if [[ -n $used ]]; then
    echo "Used: $(( (used + 59) / 60 )) min   Earned: $(format_minutes "$earned") (cap $(config cap "$DEFAULT_CAP") min)   Banked now: $(( banked / 60 )) min"
  else
    echo "Earned: $(format_minutes "$earned") (cap $(config cap "$DEFAULT_CAP") min); use for a past day is in that day's saved report"
  fi
  echo "Math: $questions questions asked, $right right, $wrong wrong after two tries"
  # One line per question, with its outcome, from the log's own order.
  awk -v day="$day" '
    $1 == day && $3 == "question" {
      id = $4
      line = $0
      sub(/^[^ ]+ [^ ]+ question [0-9]+ text=/, "", line)
      answer = line; sub(/.* answer=/, "", answer)
      text = line; sub(/ answer=[0-9-]+$/, "", text)
      when[id] = substr($2, 1, 5); q[id] = text; a[id] = answer; order[++n] = id; verdict[id] = "no answer"
    }
    $1 == day && $3 == "correct" {
      id = $4; secs = $0; sub(/.* secs=/, "", secs); credit = $5; sub(/^\+/, "", credit)
      credit = credit + 0
      if (credit % 60 == 0) worth = (credit / 60) " min"
      else if (credit < 60) worth = credit " s"
      else worth = int(credit / 60) " min " (credit % 60) " s"
      verdict[id] = "right   " secs " s   " worth
    }
    $1 == day && $3 == "wrong" && $5 == "retired" {
      id = $4; given = $0; sub(/.* given=/, "", given); sub(/ .*/, "", given); secs = $0; sub(/.* secs=/, "", secs)
      verdict[id] = "wrong   " secs " s   answered " given
    }
    END { for (i = 1; i <= n; i++) { id = order[i]; printf "  %s  %-32s %-8s %s\n", when[id], q[id], a[id], verdict[id] } }
  ' <<<"$lines"
  local locks
  locks=$(grep -c ' locked session ' <<<"$lines" || true)
  echo "Locked when time ran out: $locks times"
}

write_report() {
  local day=$1 stage
  [[ $day =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || fail "report needs a date as YYYY-MM-DD"
  install -d -m 0700 "$DIR/reports"
  stage=$(mktemp)
  build_report "$day" >"$stage"
  install -m 0600 "$stage" "$DIR/reports/$day.txt"
  rm -f "$stage"
  cat "$DIR/reports/$day.txt"
}

do_report() {
  local day=${1:-$(date +%F)}
  require_root report
  [[ -d $DIR ]] || fail "screen time is not set up for $USER_NAME"
  if [[ $day != "$(read_file day)" && -f $DIR/reports/$day.txt ]]; then
    cat "$DIR/reports/$day.txt"
  else
    write_report "$day"
  fi
}

require_writable() {
  require_root "$1"
  [[ -d $DIR ]] || fail "screen time is not set up for $USER_NAME"
  [[ -f $DIR/enabled ]] || fail "screen time is off for $USER_NAME"
  # One writer at a time: the timer's tick and an answer must not race their
  # read-modify-write of the budget.
  exec 9>"$DIR/.lock"
  if command -v flock >/dev/null; then flock 9; fi
}

do_question() {
  require_writable question
  roll_day

  local id
  id=$(read_file next-id 1)
  [[ $id =~ ^[0-9]+$ ]] || id=1
  write_file next-id $((id + 1))

  generate_question "$(config level "$DEFAULT_LEVEL")"
  write_file question "id=$id
answer=$question_answer
issued=$(date +%s)
attempts=0
text=$question_text" 0600
  log_event "question $id text=$question_text answer=$question_answer"
  write_status
  printf '%s %s\n' "$id" "$question_text"
}

pending() {
  local key=$1
  sed -n "s/^$key=//p" "$DIR/question" 2>/dev/null | head -1
}

do_answer() {
  require_writable answer
  roll_day

  local id="" value=""
  read -r id value || [[ -n $id ]] || fail "answer needs '<id> <value>' on stdin"
  value=${value//[[:space:],]/}

  local expected issued attempts now
  if [[ ! -f $DIR/question || $(pending id) != "$id" ]]; then
    echo stale
    return 0
  fi
  expected=$(pending answer)
  issued=$(pending issued)
  attempts=$(pending attempts)
  now=$(date +%s)
  if (( now - issued > QUESTION_TTL )); then
    rm -f "$DIR/question"
    log_event "expired $id"
    echo stale
    return 0
  fi

  if [[ $value =~ ^-?[0-9]+$ ]] && (( value == expected )); then
    # The credit is in seconds: the set's minutes shared over its questions,
    # bounded by what is left of today's cap. earned counts seconds too.
    local cap earned credit
    cap=$(( $(config cap "$DEFAULT_CAP") * 60 ))
    earned=$(read_file earned 0)
    [[ $earned =~ ^[0-9]+$ ]] || earned=0
    credit=$(credit_seconds)
    (( earned + credit > cap )) && credit=$((cap - earned))
    (( credit < 0 )) && credit=0
    write_file budget $(( $(budget_seconds) + credit ))
    write_file earned $((earned + credit))
    rm -f "$DIR/question"
    log_event "correct $id +$credit given=$value secs=$((now - issued))"
    write_status
    printf 'correct %s %s\n' "$credit" "$(budget_seconds)"
    return 0
  fi

  attempts=$((attempts + 1))
  if (( attempts >= MAX_ATTEMPTS )); then
    rm -f "$DIR/question"
    log_event "wrong $id retired given=$value expected=$expected secs=$((now - issued))"
    printf 'wrong %s\n' "$expected"
  else
    write_file question "id=$id
answer=$expected
issued=$issued
attempts=$attempts
text=$(pending text)" 0600
    log_event "wrong $id given=$value"
    echo wrong
  fi
}

# A practice question for the app, checked by the app: the text and the
# answer together, nothing recorded, no privilege needed. The level is the
# grade the kid picked, which the parent's level setting does not touch.
do_practice() {
  local level=${1:-$DEFAULT_LEVEL}
  [[ $level =~ ^grade[1-6]$ ]] || fail "practice needs a level from grade1 to grade6"
  generate_question "$level"
  printf '%s\t%s\n' "$question_text" "$question_answer"
}

do_status() {
  # Refresh from the files when this can write (root under the grant, or a
  # test); the kid running it bare just reads what the last writer left.
  if [[ -d $DIR ]] && { (( EUID == 0 )) || [[ -n ${OMARCHY_PARENT_STATE_DIR:-} ]]; }; then
    write_status
  fi
  if [[ -f $DIR/status.json ]]; then
    cat "$DIR/status.json"
  else
    printf '{"enabled":false,"budget":0,"earnedToday":0,"cap":%s,"rate":%s,"questions":%s,"sessionMinutes":%s,"level":"%s"}\n' \
      "$DEFAULT_CAP" "$DEFAULT_RATE" "$DEFAULT_QUESTIONS" "$DEFAULT_MINUTES" "$DEFAULT_LEVEL"
  fi
}

# The timer's tick: take SECONDS off the budget for a stretch of unlocked
# session, and say how much is left. Root only, and never through the grant.
do_consume() {
  local seconds=$1
  [[ $seconds =~ ^[0-9]+$ ]] || fail "consume needs a number of seconds"
  require_writable consume
  roll_day
  # School hours are not screen time.
  in_school_hours && seconds=0
  local before budget charged
  before=$(budget_seconds)
  budget=$(( before - seconds ))
  (( budget < 0 )) && budget=0
  charged=$(( before - budget ))
  write_file budget "$budget"
  if (( charged > 0 )); then
    write_file used $(( $(read_file used 0) + charged ))
  fi
  write_status
  echo "$budget"
}

# The parent's grant of minutes, outside the daily cap. Root only.
do_credit() {
  local minutes=$1
  [[ $minutes =~ ^[0-9]+$ ]] || fail "credit needs a number of minutes"
  require_writable credit
  roll_day
  write_file budget $(( $(budget_seconds) + minutes * 60 ))
  log_event "grant $minutes"
  write_status
  budget_seconds
  echo
}

# Exit 0 lets the unlock proceed: gating is off, it is school time, or there
# is time in the bank. Reads only, and only world-readable files, since PAM
# runs this as the kid.
do_gate() {
  [[ -f $DIR/enabled ]] || exit 0
  in_school_hours && exit 0
  (( $(budget_seconds) > 0 ))
}

# Exit 0 during a school window; the timer asks before charging or locking.
do_school() {
  in_school_hours
}

usage() {
  echo "Usage: omarchy-parent-quiz [--user NAME] <question|answer|status|gate|school|consume SECONDS|credit MINUTES|report [DATE]|practice [grade1..grade6]>" >&2
  exit 1
}

NAMED_USER=""
if [[ ${1:-} == "--user" ]]; then
  NAMED_USER=${2:-}
  [[ -n $NAMED_USER ]] || usage
  shift 2
fi

command=${1:-}
case $command in
  question|answer|status|gate|school) (( $# == 1 )) || usage ;;
  consume|credit) (( $# == 2 )) || usage ;;
  report|practice) (( $# <= 2 )) || usage ;;
  *) usage ;;
esac

# Practice needs neither an account nor its state.
if [[ $command == practice ]]; then
  do_practice "${2:-}"
  exit 0
fi

USER_NAME=$(account)
DIR=$(dir_for "$USER_NAME")

case $command in
  question) do_question ;;
  answer) do_answer ;;
  status) do_status ;;
  gate) do_gate ;;
  school) do_school ;;
  consume) do_consume "$2" ;;
  credit) do_credit "$2" ;;
  report) do_report "${2:-}" ;;
esac
