#!/bin/bash

# omarchy:summary=Log LLM prompts on a child install (observe only)
# omarchy:args=<on|off|status|report|hosts> ...
# omarchy:examples=sudo omarchy-parent llm on | omarchy parent llm report --date 2026-09-02
# omarchy:requires-sudo=true

# Observe-only LLM prompt log for kids mode. Does not block ChatGPT or any
# other site. on installs a Chromium policy, a native-messaging host, and
# systemd units that append prompts to a root-owned journal and write a daily
# markdown report under the root account. off removes the collectors and keeps
# the reports unless --purge is passed.

set -euo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

usage() {
  cat <<USAGE
Usage: omarchy-parent llm on [--user NAME]
       omarchy-parent llm off [--user NAME] [--purge]
       omarchy-parent llm status
       omarchy-parent llm report [--date YYYY-MM-DD]
       omarchy-parent llm hosts

on      Start recording prompts from the stock browser and coding-agent CLIs.
        Daily markdown is written to /root/llm-reports. Does not block access.
off     Stop recording. Keeps the journal and reports unless --purge.
status  Show whether the log is on, and today's prompt count.
report  Print the day's report (today if --date is omitted), generating it first.
hosts   Show the LLM sites whose prompts are recorded.
USAGE
}

fail() {
  echo "Error: $1" >&2
  exit 1
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

if (( EUID != 0 )) && [[ -z ${OMARCHY_PARENT_LLM_UNPRIVILEGED:-} ]]; then
  mapfile -t gum_env < <(env | grep '^GUM_' || true)
  exec sudo env "${gum_env[@]}" "$0" "$@"
fi

source "$OMARCHY_PATH/install/helpers/parent.sh"

PARENT_LIB="${OMARCHY_PARENT_LIB:-/var/lib/omarchy/parent}"
REPORT_DIR="${OMARCHY_PARENT_REPORT_DIR:-/root/llm-reports}"
SYSTEMD_DIR="${OMARCHY_SYSTEMD_DIR:-/etc/systemd/system}"
ENV_FILE="$PARENT_LIB/llm.env"
UNIT_SRC="$OMARCHY_PATH/default/parent/systemd"
HOST_TEMPLATE="$OMARCHY_PATH/default/chromium/native-messaging-hosts/com.omarchy.parent_llm.json"
HOSTS_SRC="$OMARCHY_PATH/default/parent/llm-hosts.txt"
EXTENSION_DIR="$OMARCHY_PATH/default/chromium/extensions/llm-monitor"
COLLECT="$OMARCHY_PATH/bin/omarchy-parent-llm-collect"
HOST_BIN="$OMARCHY_PATH/bin/omarchy-parent-llm-host"

UNITS=(
  omarchy-parent-llm.socket
  omarchy-parent-llm@.service
  omarchy-parent-llm-report.service
  omarchy-parent-llm-report.timer
  omarchy-parent-llm-harvest.service
  omarchy-parent-llm-harvest.timer
)

if [[ -n ${OMARCHY_BROWSER_POLICY_MANAGED_DIRS:-} ]]; then
  IFS=: read -r -a POLICY_DIRS <<< "$OMARCHY_BROWSER_POLICY_MANAGED_DIRS"
else
  POLICY_DIRS=(
    /etc/chromium/policies/managed
    /etc/opt/chrome/policies/managed
    /etc/opt/edge/policies/managed
    /etc/brave/policies/managed
  )
fi

if [[ -n ${OMARCHY_NATIVE_MESSAGING_DIRS:-} ]]; then
  IFS=: read -r -a NATIVE_DIRS <<< "$OMARCHY_NATIVE_MESSAGING_DIRS"
else
  NATIVE_DIRS=(
    /etc/chromium/native-messaging-hosts
    /etc/opt/chrome/native-messaging-hosts
    /etc/opt/edge/native-messaging-hosts
    /etc/brave/native-messaging-hosts
  )
fi

require_child_install() {
  omarchy-profile-child || fail "this is not a child install; omarchy-parent llm only applies to the kids mode profile"
}

require_user() {
  [[ -n $user ]] || fail "$1 needs --user NAME"
  [[ $user != "root" ]] || fail "the kid account cannot be root"
  getent passwd "$user" >/dev/null || fail "user '$user' does not exist"
}

kid_home() {
  getent passwd "$1" | cut -d: -f6
}

kid_uid() {
  getent passwd "$1" | cut -d: -f3
}

state_dir_for() {
  printf '%s/%s/llm\n' "$PARENT_LIB" "$1"
}

systemd_live() {
  [[ $SYSTEMD_DIR == /etc/systemd/system ]] && [[ -d /run/systemd/system ]]
}

write_env_file() {
  local user="$1" uid="$2" home="$3" state="$4"
  mkdir -p "$PARENT_LIB"
  {
    printf 'OMARCHY_PARENT_LLM_USER=%s\n' "$user"
    printf 'OMARCHY_PARENT_LLM_UID=%s\n' "$uid"
    printf 'OMARCHY_PARENT_LLM_HOME=%s\n' "$home"
    printf 'OMARCHY_PARENT_LLM_JOURNAL=%s\n' "$state/journal.jsonl"
    printf 'OMARCHY_PARENT_LLM_STATE=%s\n' "$state"
    printf 'OMARCHY_PARENT_LLM_REPORT_DIR=%s\n' "$REPORT_DIR"
    printf 'OMARCHY_PARENT_LLM_HOSTS=%s\n' "$state/hosts.txt"
  } >"$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

load_env_file() {
  [[ -f $ENV_FILE ]] || return 1
  # shellcheck disable=SC1090
  source "$ENV_FILE"
}

write_policy() {
  local dir stage
  for dir in "${POLICY_DIRS[@]}"; do
    mkdir -p "$dir"
    stage=$(mktemp)
    cat >"$stage" <<'JSON'
{"IncognitoModeAvailability": 1, "BrowserGuestModeEnabled": false}
JSON
    install -m644 "$stage" "$dir/llm.json"
    rm -f "$stage"
  done
}

remove_policy() {
  local dir
  for dir in "${POLICY_DIRS[@]}"; do
    rm -f "$dir/llm.json"
  done
}

write_native_host() {
  local dir stage
  [[ -f $HOST_TEMPLATE ]] || fail "native messaging template is missing"
  for dir in "${NATIVE_DIRS[@]}"; do
    mkdir -p "$dir"
    stage=$(mktemp)
    sed "s|__HOST_PATH__|$HOST_BIN|g" "$HOST_TEMPLATE" >"$stage"
    install -m644 "$stage" "$dir/com.omarchy.parent_llm.json"
    rm -f "$stage"
  done
}

remove_native_host() {
  local dir
  for dir in "${NATIVE_DIRS[@]}"; do
    rm -f "$dir/com.omarchy.parent_llm.json"
  done
}

install_units() {
  local unit
  mkdir -p "$SYSTEMD_DIR"
  for unit in "${UNITS[@]}"; do
    install -m644 "$UNIT_SRC/$unit" "$SYSTEMD_DIR/$unit"
  done
  if systemd_live; then
    systemctl daemon-reload
    systemctl enable --now omarchy-parent-llm.socket >/dev/null
    systemctl enable --now omarchy-parent-llm-report.timer >/dev/null
    systemctl enable --now omarchy-parent-llm-harvest.timer >/dev/null
  fi
}

remove_units() {
  if systemd_live; then
    systemctl disable --now omarchy-parent-llm.socket >/dev/null 2>&1 || true
    systemctl disable --now omarchy-parent-llm-report.timer >/dev/null 2>&1 || true
    systemctl disable --now omarchy-parent-llm-harvest.timer >/dev/null 2>&1 || true
  fi
  local unit
  for unit in "${UNITS[@]}"; do
    rm -f "$SYSTEMD_DIR/$unit"
  done
  if systemd_live; then
    systemctl daemon-reload
  fi
}

add_extension_flag() {
  local flags="$1" path="$2" tmp line
  mkdir -p "$(dirname "$flags")"
  if [[ -f $flags ]] && grep -Fq -- "$path" "$flags"; then
    return 0
  fi
  if [[ -f $flags ]] && grep -q '^--load-extension=' "$flags"; then
    tmp=$(mktemp)
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line == --load-extension=* ]]; then
        printf '%s,%s\n' "$line" "$path"
      else
        printf '%s\n' "$line"
      fi
    done <"$flags" >"$tmp"
    install -m644 "$tmp" "$flags"
    rm -f "$tmp"
  elif [[ -f $flags ]]; then
    printf '%s\n' "--load-extension=$path" >>"$flags"
  else
    printf '%s\n' "--load-extension=$path" >"$flags"
  fi
}

remove_extension_flag() {
  local flags="$1" path="$2" tmp line rest part joined
  local -a kept
  [[ -f $flags ]] || return 0
  tmp=$(mktemp)
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == --load-extension=* ]]; then
      rest=${line#--load-extension=}
      kept=()
      IFS=',' read -ra parts <<< "$rest"
      for part in "${parts[@]}"; do
        [[ $part == "$path" ]] && continue
        kept+=("$part")
      done
      if (( ${#kept[@]} > 0 )); then
        joined=$(IFS=,; printf '%s' "${kept[*]}")
        printf '%s%s\n' "--load-extension=" "$joined"
      fi
    else
      printf '%s\n' "$line"
    fi
  done <"$flags" >"$tmp"
  install -m644 "$tmp" "$flags"
  rm -f "$tmp"
}

cmd_on() {
  local home uid state
  require_child_install
  require_user on
  home=$(kid_home "$user")
  uid=$(kid_uid "$user")
  [[ -n $home && -n $uid ]] || fail "could not resolve the kid account"
  state=$(state_dir_for "$user")

  install -d -m 700 "$state"
  install -d -m 700 "$REPORT_DIR"
  if [[ ! -f $state/hosts.txt ]]; then
    install -m644 "$HOSTS_SRC" "$state/hosts.txt"
  fi
  if [[ ! -f $state/journal.jsonl ]]; then
    : >"$state/journal.jsonl"
    chmod 600 "$state/journal.jsonl"
  fi

  write_env_file "$user" "$uid" "$home" "$state"
  write_policy
  write_native_host
  install_units
  if [[ ! -f $home/.config/chromium-flags.conf && -f $OMARCHY_PATH/config/chromium-flags.conf ]]; then
    mkdir -p "$home/.config"
    install -m644 "$OMARCHY_PATH/config/chromium-flags.conf" "$home/.config/chromium-flags.conf"
  fi
  add_extension_flag "$home/.config/chromium-flags.conf" "$EXTENSION_DIR"

  conf_document llm off \
    "llm: observe-only LLM prompt log." \
    "  off  no collector, no report timer (default)" \
    "  on   record prompts from the stock browser and coding-agent CLIs;" \
    "       daily markdown lands in /root/llm-reports. Does not block access."
  conf_set llm on

  echo "LLM prompt log is on for $user."
  echo "Daily reports: $REPORT_DIR"
  echo "This does not block ChatGPT or any other site."
}

cmd_off() {
  local home state
  require_child_install
  if [[ -z $user ]] && [[ -f $ENV_FILE ]]; then
    load_env_file || true
    user="${OMARCHY_PARENT_LLM_USER:-}"
  fi
  if [[ -n $user ]]; then
    home=$(kid_home "$user" 2>/dev/null || true)
    state=$(state_dir_for "$user")
    [[ -n $home ]] && remove_extension_flag "$home/.config/chromium-flags.conf" "$EXTENSION_DIR"
    if (( purge )); then
      rm -rf "$state"
      rm -rf "$REPORT_DIR"
    fi
  fi
  remove_policy
  remove_native_host
  remove_units
  rm -f "$ENV_FILE"
  conf_set llm off
  echo "LLM prompt log is off."
  if (( purge )); then
    echo "Journal and reports removed."
  else
    echo "Journal and $REPORT_DIR kept. Pass --purge to delete them."
  fi
}

cmd_status() {
  local mode count journal
  mode=$(conf_get llm off)
  echo "llm=$mode"
  if load_env_file; then
    echo "user=$OMARCHY_PARENT_LLM_USER"
    echo "journal=$OMARCHY_PARENT_LLM_JOURNAL"
    echo "reports=$OMARCHY_PARENT_LLM_REPORT_DIR"
    journal=$OMARCHY_PARENT_LLM_JOURNAL
    if [[ -f $journal ]]; then
      count=$(grep -c . "$journal" 2>/dev/null || true)
      echo "journal_lines=${count:-0}"
    fi
    if [[ -f $OMARCHY_PARENT_LLM_REPORT_DIR/latest.md ]]; then
      echo "latest=$OMARCHY_PARENT_LLM_REPORT_DIR/latest.md"
    fi
  fi
}

cmd_report() {
  load_env_file || fail "the LLM prompt log has never been turned on"
  export OMARCHY_PARENT_LLM_USER OMARCHY_PARENT_LLM_UID OMARCHY_PARENT_LLM_HOME
  export OMARCHY_PARENT_LLM_JOURNAL OMARCHY_PARENT_LLM_STATE
  export OMARCHY_PARENT_LLM_REPORT_DIR OMARCHY_PARENT_LLM_HOSTS
  "$COLLECT" harvest >/dev/null || true
  local -a args
  args=(report --print)
  [[ -n $report_date ]] && args+=(--date "$report_date")
  "$COLLECT" "${args[@]}"
}

cmd_hosts() {
  local file=$HOSTS_SRC
  if load_env_file && [[ -f ${OMARCHY_PARENT_LLM_HOSTS:-} ]]; then
    file=$OMARCHY_PARENT_LLM_HOSTS
  fi
  cat "$file"
}

command="${1:-}"
[[ -n $command ]] || { usage >&2; exit 1; }
shift

user=""
purge=0
report_date=""
positional=()
while (($#)); do
  case "$1" in
    --user)
      user="${2:-}"
      shift 2
      ;;
    --purge)
      purge=1
      shift
      ;;
    --date)
      report_date="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done

[[ -n $user ]] || user="${SUDO_USER:-}"

case "$command" in
  on)
    cmd_on
    ;;
  off)
    cmd_off
    ;;
  status)
    cmd_status
    ;;
  report)
    cmd_report
    ;;
  hosts)
    cmd_hosts
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
